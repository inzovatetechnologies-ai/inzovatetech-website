{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/blog/(.*)",
      "destination": "/blogs/$1",
      "permanent": true
    },
    {
      "source": "/career",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/partnerships",
      "destination": "/strategic-partnerships",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
